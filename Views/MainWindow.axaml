<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="DesktopNotes.Views.MainWindow"
        Title="桌面便笺"
        Width="400" Height="560"
        Icon="avares://DesktopNotes/Assets/app.ico"
        WindowStartupLocation="CenterScreen">

  <Grid RowDefinitions="Auto,Auto,*,Auto,Auto" Margin="14">

    <TextBlock Text="📝 桌面便笺" FontSize="20" FontWeight="Bold" />

    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="0,12,0,10">
      <Button Classes="primary" Background="#FFF6B3" Content="📄 新建便签" Click="NewNote_Click" />
      <Button Classes="primary" Background="#C8F7C5" Content="✅ 新建待办" Click="NewTodo_Click" />
      <Button Classes="primary" Background="#BDE3FF" Content="🕐 新建时间轴" Click="NewTimeline_Click" />
    </StackPanel>

    <ScrollViewer Grid.Row="2">
      <ItemsControl ItemsSource="{Binding Notes}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Background="{Binding Color, Converter={StaticResource HexBrush}}"
                    CornerRadius="8" Padding="10,8" Margin="0,4">
              <Grid ColumnDefinitions="Auto,*,Auto">
                <TextBlock Text="{Binding TypeIcon}" FontSize="18"
                           VerticalAlignment="Center" Margin="0,0,8,0" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                  <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                  <TextBlock FontSize="11" Opacity="0.65">
                    <Run Text="{Binding TypeLabel}" />
                    <Run Text="· 双击标题栏拖动 · 嵌入桌面后位于图标之下" />
                  </TextBlock>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                  <Button Classes="note-btn" Content="打开" Click="Open_Click" ToolTip.Tip="打开 / 显示窗口" />
                  <Button Classes="note-btn" Content="🗑" Click="Delete_Click" ToolTip.Tip="删除便笺" />
                </StackPanel>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

    <Grid Grid.Row="3" ColumnDefinitions="Auto,Auto,Auto,*" Margin="0,10,0,0">
      <CheckBox Content="开机自启" IsChecked="{Binding AutoStartEnabled}" VerticalAlignment="Center"
                ToolTip.Tip="登录 Windows 后自动在托盘运行，并恢复桌面便笺" />
      <Button Grid.Column="1" Content="导入便笺" Click="ImportSticky_Click" Margin="12,0,0,0"
              ToolTip.Tip="把 Windows 自带便笺的内容复制到这里，可重复点击同步" />
      <Button Grid.Column="2" Content="导出便笺" Click="ExportSticky_Click" Margin="6,0,0,0"
              ToolTip.Tip="把这里的便笺写回 Windows 自带便笺（会先备份系统便笺数据库）" />
      <TextBlock Grid.Column="3" Text="{Binding ImportStatus}" FontSize="11" Opacity="0.65"
                 VerticalAlignment="Center" HorizontalAlignment="Right"
                 TextTrimming="CharacterEllipsis" />
    </Grid>

    <Grid Grid.Row="4" ColumnDefinitions="*,Auto" Margin="0,8,0,0">
      <TextBlock Text="{Binding StatusText}" Opacity="0.7" VerticalAlignment="Center" />
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
        <Button Content="全部嵌入" Click="EmbedAll_Click" ToolTip.Tip="所有便笺嵌入桌面" />
        <Button Content="全部还原" Click="UnembedAll_Click" ToolTip.Tip="所有便笺退出桌面嵌入" />
      </StackPanel>
    </Grid>

  </Grid>
</Window>
