<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="DesktopNotes.Views.TimelineEntryEditWindow"
        Title="编辑时间轴条目"
        Width="400" Height="310"
        MinWidth="400" MinHeight="310"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

  <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto" Margin="18">
    <TextBlock Text="时间" FontSize="14" FontWeight="Bold" />
    <TextBox x:Name="TimeInput" Grid.Row="1" Margin="0,6,0,12"
             Watermark="yyyy-MM-dd HH:mm:ss"
             KeyDown="TimeInput_KeyDown" />
    <TextBlock Grid.Row="2" Text="内容" FontSize="14" FontWeight="Bold" />
    <TextBox x:Name="ContentInput" Grid.Row="3" Margin="0,6,0,0"
             AcceptsReturn="True" TextWrapping="Wrap" MinHeight="90"
             Watermark="输入时间轴内容"
             KeyDown="ContentInput_KeyDown" />
    <TextBlock x:Name="ValidationText" Grid.Row="4" Margin="0,6,0,0"
               Foreground="#B42318" FontSize="11" IsVisible="False" />
    <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button Content="取消" Click="Cancel_Click" />
      <Button Content="确定" Click="Save_Click" IsDefault="True" />
    </StackPanel>
  </Grid>
</Window>